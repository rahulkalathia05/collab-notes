# Copy to backend/.env and fill in the values.
# backend/.env is gitignored — never commit it.
#
# Docker note: DATABASE_URL and REDIS_URL below are for running the backend
# directly on the host (no Docker). When using docker compose these are
# overridden by docker-compose.yml to use service names (postgres / redis).

APP_NAME=CollabNotes API
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Host-side ports when running DB+Redis via docker compose (5433 / 6380
# are used to avoid conflicts with locally-installed services).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/collabnotes

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI (optional — enables AI features + semantic search) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3010"]
